# No credentials should be committed to source control.
DALAN_APP_MODE=development
DALAN_SERVICE_AREA=Roxas City, Capiz
DALAN_TIMEZONE=Asia/Manila
DALAN_TRANSPORT_DATA_STATUS=unverified

# Obtain these from DALAN's own Vercel project / Neon connection.
# DALAN_DATABASE_URL=postgresql://...
# DALAN_ADMIN_PASSWORD_HASH=<scrypt salt hex>:<scrypt hash hex>
# DALAN_ADMIN_SESSION_SECRET=<random secret>
